# Runner Railway — Variables d'environnement
#
# Les deux SUPABASE_* ont des défauts hardcodés (projet mirakl-hackathon,
# anon key) pour que le déploiement marche out-of-the-box pendant le
# hackathon. En prod tu les surchargeras ici.

SUPABASE_URL=https://ltuarofidogdjhzosboe.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # anon key OK

# Fréquence de poll de scraping_jobs (secondes)
POLL_SECONDS=15

# Mode headless Chrome — OBLIGATOIRE sur Railway (pas de display serveur)
SCRAPER_HEADLESS=1

# Chemin du binaire Chrome (le Dockerfile le configure déjà à /usr/bin/google-chrome)
# CHROME_BIN=/usr/bin/google-chrome
